# === REQUIRED: Generate a strong secret key (min 32 chars) ===
# On Linux/Mac: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-32-char-string

# === PostgreSQL (used in docker-compose) ===
# DATABASE_URL is set inside docker-compose.yml for the web container

# === AES Encryption Key (exactly 32 bytes) ===
AES_KEY=32-bytes-encryption-key-for-aes-256!!

# === Cloud Sync API URL ===
CLOUD_API_URL=http://localhost:5000/api/sync
